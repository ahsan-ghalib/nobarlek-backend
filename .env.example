APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

THE_SPORTS_API_URL=
THE_SPORTS_USER_NAME=
THE_SPORTS_SECRET=

# HLS playback template for TheSports RTMP restreams. Use {stream_key} placeholder.
# Example: https://cdn.example.com/live/{stream_key}.m3u8
STREAM_PLAYBACK_URL_TEMPLATE=
# STREAM_FOOTBALL_SPORT_ID=1

# Limit scraping to Indonesian football: only competitions already in `competitions` with this country_id (+ extras below).
SCRAPING_INDONESIA_ONLY=false
# Comma-separated TheSports country_id values for Indonesia (recommended when indonesia_only=true).
SCRAPING_ALLOWED_COUNTRY_IDS=
# Optional extra competition UUIDs to always include.
SCRAPING_EXTRA_COMPETITION_IDS=

# Match diary `/football/match/diary` (date query): calendar TZ, param format, future-day window for --future job.
# Use Asia/Jakarta if diary days look empty while TheSports shows fixtures (midnight boundary vs Indonesia local day).
# SCRAPING_DIARY_CALENDAR_TZ=UTC
# type=diary (default). Date field is usually `time` (unix); `date` often triggers API code 100003.
# SCRAPING_DIARY_QUERY_TYPE=diary
# SCRAPING_DIARY_DATE_PARAM=time
# SCRAPING_DIARY_DATE_PARAM=date
# unix_start_of_day | Y-m-d | Ymd
# SCRAPING_DIARY_DATE_FORMAT=unix_start_of_day
# SCRAPING_DIARY_FUTURE_DAYS=7
# Optional JSON merge into query string: SCRAPING_DIARY_EXTRA_JSON={}
